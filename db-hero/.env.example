# ---------------------------------------------------------------------------
# Qoot — site configuration. Copy to `.env` and fill in real values.
# All are optional; safe placeholder defaults are used when unset.
# (Vite only exposes variables prefixed with VITE_ to the browser.)
# ---------------------------------------------------------------------------

# Brand
VITE_BRAND_NAME=Qoot
VITE_BRAND_DOMAIN=qoot.example

# Contact — shown in the footer / contact section
VITE_CONTACT_EMAIL=hello@qoot.example
VITE_CONTACT_PHONE=+966500000000

# WhatsApp — digits only, international format, NO leading "+"
VITE_WHATSAPP_NUMBER=966500000000
VITE_WHATSAPP_MESSAGE=Hi, I saw your restaurant technology portfolio and I'd like to discuss building an app for my restaurant.

# Optional: POST endpoint for the contact form (e.g. Formspree, a serverless
# function, etc.). If left empty, the form falls back to a pre-filled email.
VITE_FORM_ENDPOINT=
