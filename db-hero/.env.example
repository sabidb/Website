# ---------------------------------------------------------------------------
# RestoPOS — site configuration. Copy to `.env` and fill in real values.
# All are optional; safe placeholder defaults are used when unset.
# (Vite only exposes variables prefixed with VITE_ to the browser.)
# ---------------------------------------------------------------------------

# Brand
VITE_BRAND_NAME=RestoPOS
VITE_BRAND_DOMAIN=restopos.store

# Contact — shown in the footer / contact section
VITE_CONTACT_EMAIL=sabiidb7@gmail.com
VITE_CONTACT_PHONE=+966538360053

# WhatsApp — digits only, international format, NO leading "+"
VITE_WHATSAPP_NUMBER=966538360053
VITE_WHATSAPP_MESSAGE=Hello, I'm interested in building a digital ordering/app system for my restaurant. I'd like to discuss my requirements and request a demo.

# Optional: POST endpoint for the contact form (e.g. Formspree, a serverless
# function, etc.). If left empty, the form falls back to a pre-filled email.
VITE_FORM_ENDPOINT=
